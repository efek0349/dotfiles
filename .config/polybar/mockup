[colors]
bg = #1D1F21
fg = #FFFFFF
green = #50FA7B
red = #FF5555
gray = #777777

[settings]
screenchange-reload = true
enable-ipc = true

[bar/top]
width = 350
height = 20
offset-x = 1
offset-y = -3

fixed-center = false

background = ${colors.bg}
foreground = ${colors.fg}

padding-left = 1
padding-right = 2

module-margin-left = 1
module-margin-right = 1

font-0 = Iosevka:style=Medium:size=9;2
font-1 = Terminess Nerd Font Mono:style=Regular:size=9;2

modules-left = xworkspaces search xwindow

cursor-click = pointer

[module/xwindow]
type = internal/xwindow

format = <label>
label = %title:0:40:...%
label-foreground = ${colors.fg}
label-padding = 1
label-empty =

[module/xworkspaces]
type = internal/xworkspaces

pin-workspaces = false
group-by-monitor = false
enable-click = true
enable-scroll = true

; Workspace icons
icon-0 = nogroup;
icon-1 = one;󰆍
icon-2 = two;󰈹
icon-3 = three;󰉋
icon-4 = four;󰓓
icon-5 = five;󰂺
icon-6 = six;󰭹
icon-7 = seven;󰎆
icon-8 = eight;󰞁
icon-9 = nine;󰖟

icon-default = 󰖟

format = <label-state>

label-active = %icon%
label-active-foreground = ${colors.bg}
label-active-background = ${colors.green}
label-active-padding = 1

label-occupied = %icon%
label-occupied-foreground = ${colors.fg}
label-occupied-padding = 1

label-urgent = %icon%
label-urgent-foreground = ${colors.red}
label-urgent-padding = 1

label-empty = %icon%
label-empty-foreground = ${colors.gray}
label-empty-padding = 1

[module/search]
type = custom/text

content = 󰍉
content-foreground = ${colors.green}
content-padding = 2

click-left = dmenu_run

