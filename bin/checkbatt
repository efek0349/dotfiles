#!/bin/ksh
export DISPLAY=:0.0

[[ `apm -a` = 1 ]] && exit

battlvl="$(apm -l)"

[[ $battlvl -lt 18 ]] && /usr/bin/aucat -i /home/efek/.mutt/beep.wav && zenity --info --text="Critical level: $(apm -m) minutes" && exit 
[[ $battlvl -eq 22 ]] && zenity --info --text="Battery level: $(apm -m) minutes"
exit 0
