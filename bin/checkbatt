#!/bin/bash

export DISPLAY=:0.0

if [ "$(cat /sys/class/power_supply/AC/online)" = "1" ]; then
    exit 0
fi

battlvl=$(cat /sys/class/power_supply/BAT0/capacity)

if [ "$battlvl" -lt 70 ]; then
    echo -ne '\007' # Beep
    zenity --info --text="Critical level $(acpi -b|awk -F':' '{print $3}') remaining"
    exit 0
fi

if [ "$battlvl" -eq 75 ]; then
    zenity --info --text="Battery level $(acpi -b|awk -F':' '{print $3}') remaining"
fi

exit 0
